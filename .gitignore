/.lanswitch-data/
/.deskmesh-data/
/hardware-test-data/
/src/LanSwitch.Agent/wwwroot/
*.user
*.suo

# Runtime identity, private keys, and transient data
**/identity.bin
**/identity.bin.new
*.pfx
*.p12
*.key
*.tmp
*.temp
*.part
*.new
**/.agent.lock

# Unused files kept from the local Sites bootstrap (not part of DeskMesh)
